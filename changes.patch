+  test('coverage: generated ' + lang + ' protocol includes coverage and keeps prior controls', () => {
+    const t = G.projectGuidance(lang);
+    for (const term of ['checked', 'issue-found', 'unverified', 'not-applicable', 'risk-escalation',
+      'reviewerSession', 'NEEDS_DECISION', 'TO_GO', 'maxRounds']) assert.ok(t.includes(term), term);
