+const G = require('../lib/review-feedback-guidance');
+const coverageFindings = () => ['F5', 'F6', 'F7'].map(id => ({
+  id, location: 'lib/state.js:20', reproduction: 'Resolve an old request after switching target.',
+  requiredOutcome: 'No stale value reaches the current payload or stored state.'
+}));
+for (const mode of ['initial', 'recheck', 'independent']) {
+  test('coverage: shared bounded-pass instructions reach ' + mode + ' packets', () => {
+    const p = C.reviewPacket(sample(), mode, {
+      previousCommit: 'c'.repeat(40), openFindings: coverageFindings(),
+      architectureRefs: ['coverage.md@pinned-commit'], testCommands: ['node --test state-probe.js']
+    });
+    assert.ok(Array.isArray(G.REVIEW_COVERAGE_INSTRUCTIONS));
+    assert.deepEqual(p.instructions.slice(4), G.REVIEW_COVERAGE_INSTRUCTIONS);
+    assert.equal(p.schema, 'leerness.review-packet/v1');
+    assert.deepEqual(p.relatedContext.architectureRefs, ['coverage.md@pinned-commit']);
+    assert.equal(p.modelInvoked, false); assert.equal(p.approvalGranted, false);
+  });
+}
+test('coverage: first pass derives missing source cases without expanding frozen requirements', () => {
+  const s = sample(), before = JSON.stringify(s), p = C.reviewPacket(s, 'initial');
+  const t = p.instructions.join(' ');
+  assert.match(t, /one bounded pass over the frozen scope/);
+  assert.match(t, /Inspect the pinned source and add missing in-scope cases/);
+  assert.match(t, /implementer checklist is not proof of completeness/);
+  assert.equal(JSON.stringify(s), before);
+  assert.deepEqual(p.task.criteria, s.manifest.criteria);
+  assert.equal(p.task.frozenDigest, C.scopeDigest(s.manifest));
+});
+test('coverage: transitions carry a common invariant through request and persistence', () => {
+  const t = C.reviewPacket(sample(), 'initial').instructions.join(' ');
+  for (const term of ['loading/success/failure', 'late or cancelled responses', 'retries',
+    'repeated effects', 'submission during reload or lock', 'concurrent clients',
+    'state, request payload and server persistence', 'cases that do not apply']) assert.ok(t.includes(term), term);
+});
+test('coverage: first blocker does not end safe inspection or hide other findings', () => {
+  const t = C.reviewPacket(sample(), 'initial').instructions.join(' ');
+  assert.match(t, /Do not stop safe inspection at the first blocking finding/);
+  assert.match(t, /ALL blocking findings found in this pass together/);
+  assert.match(t, /keep non-blocking notes separate/);
+  assert.match(t, /Never claim that every possible defect has been found/);
+});
+test('coverage: each row distinguishes static inspection, test execution and unknowns', () => {
+  const t = C.reviewPacket(sample(), 'initial').instructions.join(' ');
+  for (const term of ['checked, issue-found, unverified or not-applicable', 'file:line',
+    'inspected statically or tested', 'Checked does not mean test PASS',
+    'unrun required check stays unverified', 'reference alone is not verified coverage']) assert.ok(t.includes(term), term);
+});
+test('coverage: rechecks preserve all findings and focus on changed or unverified rows', () => {
+  const s = sample(), details = { previousCommit: 'c'.repeat(40), openFindings: coverageFindings() };
+  const original = JSON.stringify(details), p = C.reviewPacket(s, 'recheck', details), t = p.instructions.join(' ');
+  assert.deepEqual(p.openFindings.map(f => f.id), ['F5', 'F6', 'F7']);
+  assert.equal(p.previousCommit, details.previousCommit); assert.equal(p.freshSessionRequired, false);
+  assert.match(t, /same stage session where available/);
+  assert.match(t, /affected transitions and relevant previously unverified rows/);
+  assert.match(t, /not unrelated whole-project searches/);
+  p.openFindings[0].id = 'changed-copy'; assert.equal(JSON.stringify(details), original);
+});
+test('coverage: independent packet keeps earlier concrete findings out', () => {
+  const details = { previousCommit: 'c'.repeat(40), openFindings: coverageFindings() };
+  const p = C.reviewPacket(sample(), 'independent', details);
+  assert.equal(p.freshSessionRequired, true); assert.equal(p.previousReviewerConclusionsIncluded, false);
+  assert.equal(p.openFindings, undefined); assert.equal(p.previousCommit, undefined);
+  assert.ok(!JSON.stringify(p).includes(details.openFindings[0].reproduction));
+  assert.match(p.instructions.join(' '), /no earlier conclusions before its cold findings are recorded/);
+});
+test('coverage: resource or safety limits report remaining scope instead of unlimited review', () => {
+  const t = C.reviewPacket(sample(), 'initial').instructions.join(' ');
+  for (const term of ['frozen budget, access rights and safe execution boundary', 'record limits',
+    'inspected and remaining scope', 'do not silently truncate, reset review IDs or infer PASS',
+    'length limits to the summary', 'referenced detailed report']) assert.ok(t.includes(term), term);
+});
+test('coverage: late existing defects retain escalation, not severity laundering', () => {
