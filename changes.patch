+  const r = runIn(P, ['bugfix', 'start', T, '--repro', repro, '--expect-bad', 'BADSIG', '--path', P, '--json'], { ...env, BF_STORE: storeFile(P), BF_BAD: bad });
+  assert.notStrictEqual(r.status, 0, show(r));
+  assert.strictEqual(json(r, 'bugfix start').code, 'store_invalid', show(r));
+  assert.strictEqual(storeBytes(P), bad, 'store bytes changed');
+});
+
+test('a receipt saved by another process after this one read the store keeps both receipts\' fields', () => {
+  const P = fresh();
+  const A = addTask(P, 'concurrent receipt'); startFix(P, A);
+  const flags = { '--areas': 'src/orders.js' };
+  const exitBefore = process.exitCode;
+  const origLog = console.log; console.log = () => {};
+  try {
+    bugfix.bugfixCmd(P, 'receipt', [A], {
+      arg: (k, d) => (k in flags ? flags[k] : d), has: k => k in flags,
+      _withLock: (f, fn) => {
+        const list = JSON.parse(fs.readFileSync(f, 'utf8'));
+        list.find(e => e.id === A).rootCause = 'saved by the other receipt';
+        fs.writeFileSync(f, JSON.stringify(list, null, 2) + '\n');
+        return fn();
+      },
+    });
+  } finally { console.log = origLog; }
+  const exitAfter = process.exitCode; process.exitCode = exitBefore;
+  assert.ok(!exitAfter, 'receipt failed with exit ' + exitAfter);
+  assert.deepStrictEqual([entry(P, A).rootCause, entry(P, A).areas], ['saved by the other receipt', ['src/orders.js']]);
+});
+
