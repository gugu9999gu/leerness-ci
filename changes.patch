@@ -246,0 +247,36 @@
+
+test('strict path selftest checks every command in both forms and rejects unrelated child failures', () => {
+  const { _p0101PathStrictOk } = require('../bin/leerness.js');
+  const calls = [];
+  function answer(_node, [, command, ...args]) {
+    const target = args.find(a => path.isAbsolute(a));
+    const result = data => ({ status: 1, stdout: JSON.stringify(data) });
+    if (command === 'init') return { status: 0 };
+    if (command === 'health' && path.basename(target) === 'valid-project') {
+      return { status: 0, stdout: JSON.stringify({ root: target, checks: { drift: { score: 0 } } }) };
+    }
+    const explicit = args.includes('--path');
+    calls.push([command, ...args.filter(a=>!a.startsWith('--') && a !== target)].join(' ') + (explicit ? ':option' : ':positional'));
+    if (command === 'audit' && !explicit) return result({root:target, healthy:false, failures:1,
+      findings:[{kind:'not_initialized',severity:'fail',root:target}]});
+    if (command === 'gate' && !explicit) return result({ok:false, code:'error', error:target+' (.leerness/AGENTS.md)'});
+    return result({ok:false, code:'path_not_found', error:target});
+  }
+  assert.equal(_p0101PathStrictOk(answer), true);
+  assert.equal(new Set(calls).size, 50);
+  for (const bad of [
+    {status:null, error:Object.assign(new Error('timeout'),{code:'ETIMEDOUT'})},
+    {status:null,signal:'SIGTERM'}, {status:1,stdout:'not JSON'},
+    {status:1,stdout:'{"ok":false,"code":"unrelated"}'}, {status:0,stdout:'{}'},
+  ]) {
+    assert.equal(_p0101PathStrictOk((node,args)=>args[1]==='drift' ? bad : answer(node,args)), false);
+  }
+  assert.equal(_p0101PathStrictOk((node,args)=>{
+    const r=answer(node,args);
+    if (args[1]==='pulse') fs.mkdirSync(args.findLast(a=>path.isAbsolute(a)));
+    return r;
+  }),false);
+  assert.equal(_p0101PathStrictOk((node,args)=>args[1]==='init' ? {status:1} : answer(node,args)), false);
+  assert.equal(_p0101PathStrictOk((node,args)=>args[1]==='health' && !args.includes('--path') && args.some(a=>path.basename(a)==='valid-project')
+    ? {status:0,stdout:'{}'} : answer(node,args)), false);
+});
