+function runIsolatedWorker(file, prefix, rootEnv, timeout) {
+  const assert = require('assert'), cp = require('child_process');
+  const arena = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
+  try {
+    const env = { ...process.env, [rootEnv]: arena };
+    for (const key of ['HOME', 'USERPROFILE', 'LOCALAPPDATA', 'APPDATA', 'TEMP', 'TMP']) { env[key] = path.join(arena, key.toLowerCase()); fs.mkdirSync(env[key]); }
+    const r = cp.spawnSync(process.execPath, [file, '--worker', ...process.argv.slice(2)], { encoding: 'utf8', timeout, windowsHide: true, env });
+    process.stdout.write(r.stdout || ''); process.stderr.write(r.stderr || ''); if (r.error) process.stderr.write(r.error.message + '\n');
+    process.exitCode = r.status === 0 && !r.error ? 0 : 1;
+  } finally {
+    const resolved = fs.realpathSync(arena); assert.strictEqual(path.dirname(resolved).toLowerCase(), fs.realpathSync(os.tmpdir()).toLowerCase());
+    assert.ok(path.basename(resolved).startsWith(prefix)); removeTree(resolved, { recursive: true, force: true });
+  }
+}
+
+module.exports = { removeTree, RETRY_CODES, ownTree, removeOwnedTree, trackTemp, removeRecorded, RECORD_ENV, runIsolatedWorker };
