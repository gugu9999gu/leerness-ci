+*, *::before, *::after { box-sizing: border-box; }
+[hidden] { display: none !important; }
+body { margin: 0; background: var(--canvas); color: var(--text); font: var(--type-body)/1.6 var(--font-ui); }
+a { color: var(--accent); text-underline-offset: .18em; }
+button, input, select { font: inherit; color: inherit; }
+button, select { cursor: pointer; }
+button:disabled { cursor: default; opacity: .55; }
+input::placeholder { color: var(--muted); }
+:focus-visible { outline: 2px solid var(--focus); outline-offset: .2rem; }
+::selection { color: var(--text); background: #ccecdf; }
+h1, h2, h3, p { margin: 0; }
+h1 { font-size: var(--type-title); letter-spacing: -.035em; line-height: 1.25; }
+h2 { font-size: var(--type-heading); line-height: 1.45; letter-spacing: -.015em; }
+h3 { font-size: var(--type-body); }
+[id] { scroll-margin-top: var(--space-4); }
+.app { display: grid; grid-template-columns: var(--rail-width) minmax(0, 1fr); min-height: 100dvh; }
+.skip { position: fixed; z-index: 3; top: var(--space-3); left: var(--space-3); padding: var(--space-2) var(--space-4); background: var(--surface); transform: translateY(-200%); }
+.skip:focus { transform: none; }
+.rail { position: sticky; top: 0; align-self: start; height: 100dvh; display: flex; flex-direction: column; gap: var(--space-8); padding: var(--space-6) var(--space-4); background: var(--rail); color: var(--rail-foreground); }
+.brand { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-1) var(--space-2); font-size: 1.15rem; font-weight: 750; letter-spacing: -.02em; }
+.brand-mark { display: flex; align-items: flex-end; justify-content: center; gap: 3px; width: 2rem; height: 2rem; padding: .45rem; border-radius: var(--radius-control); background: #bfe8d8; }
+.brand-mark i { width: 3px; height: 50%; border-radius: .125rem; background: var(--rail); }
+.brand-mark i:nth-child(2) { height: 75%; }
+.brand-mark i:nth-child(3) { height: 100%; }
+.rail-nav { display: grid; gap: var(--space-1); }
+.rail-nav a { display: flex; align-items: center; min-height: var(--control); padding: var(--space-2) var(--space-3); border: 1px solid transparent; border-radius: var(--radius-control); color: var(--rail-muted); font-weight: 650; text-decoration: none; white-space: nowrap; }
+.rail-nav a:hover, .rail-nav a[aria-current="page"] { background: var(--rail-selection); color: var(--rail-foreground); }
+.rail-nav a[aria-current="page"] { border-color: #47745f; }
+.rail-nav a:focus-visible { outline-color: var(--rail-foreground); }
+.rail-foot { margin-top: auto; padding: var(--space-4) var(--space-2) 0; border-top: 1px solid #3b514d; }
+.rail-foot p { color: var(--rail-muted); font-size: var(--type-small); }
+.project-name { display: block; overflow-wrap: anywhere; margin-bottom: var(--space-1); }
